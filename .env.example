# ==============================================================================
# Roomly — Environment Configuration Template
# All secrets must be provided in deployment environment or local .env file.
# NEVER commit real credentials or production secrets to source control.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/roomly

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_long_for_security
JWT_REFRESH_EXPIRES_IN=7d

# Email Service (Nodemailer / SMTP)
EMAIL_SERVICE=mock
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_user
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="Roomly Luxury Hospitality" <concierge@roomly.luxury>

# Payment Provider: MOCK_SANDBOX | STRIPE | RAZORPAY
PAYMENT_PROVIDER=MOCK_SANDBOX
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Storage Provider: LOCAL | S3
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=roomly-media-bucket
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Caching & Background Queues (Optional in Dev)
REDIS_URL=redis://127.0.0.1:6379

# Logging: error | warn | info | http | debug
LOG_LEVEL=info
